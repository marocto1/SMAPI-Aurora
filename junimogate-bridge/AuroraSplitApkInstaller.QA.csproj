<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android35.0</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AuroraSplitApkInstaller.cs" />
    <!-- This QA project verifies only the standalone C# PackageInstaller bridge.
         Native Aurora Activities are compiled separately by Android javac/d8
         in the versioned APK workflows. Xamarin's default recursive Java
         compilation would duplicate legacy classes and lacks lambda desugar. -->
    <AndroidJavaSource Remove="**/*.java" />
  </ItemGroup>
</Project>
