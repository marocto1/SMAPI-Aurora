<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android35.0</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AuroraSplitApkInstaller.cs" />
    <!-- Two generations of AuroraVersionActivity share the same Android Java
         class name. QA of the split APK installer compiles ONLY the current
         v1 version; exclude the legacy version-manager/ sibling. -->
    <AndroidJavaSource Remove="version-manager/AuroraVersionActivity.java" />
  </ItemGroup>
</Project>
