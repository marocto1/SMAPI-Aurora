             return sources;
         }
 
-        if (splitNames is null ||
-            splitSourceDirs is null ||
-            splitNames.Count != splitSourceDirs.Count)
+        // Fallback to PackageInfo ONLY when ApplicationInfo omits splitNames,
+        // and only if Android reports exactly one name for every split source.
+        // Never fabricate split names from filesystem paths.
+        var splitNames = applicationSplitNames;
+        if (splitNames is null || splitNames.Count != splitSourceDirs.Count)
+        {
+            if (packageSplitNames is not null &&
+                packageSplitNames.Count == splitSourceDirs.Count)
+            {
+                splitNames = packageSplitNames;
+            }
+        }
+
+        if (splitNames is null || splitNames.Count != splitSourceDirs.Count)
         {
-            throw new InvalidOperationException("Split APK names and source paths are not aligned.");
+            throw new InvalidOperationException(
